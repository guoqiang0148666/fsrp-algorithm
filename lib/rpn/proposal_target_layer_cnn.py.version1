            self._count += 1
            self._fg_num += (labels > 0).sum()
            self._bg_num += (labels == 0).sum()
            print 'num fg avg: {}'.format(self._fg_num / self._count)
            print 'num bg avg: {}'.format(self._bg_num / self._count)
            print 'ratio: {:.3f}'.format(float(self._fg_num) / float(self._bg_num))

        #if not is_all_zero:
        #    pnums = rois.shape[0]
        #    tempname = time.time()
        #    samples = []
        #    for idx in range(pnums):
        #        coords = rois[idx, 1:5]
        #        x1, y1, x2, y2 = coords.astype(int)
        #        im = im_orig[y1:y2, x1:x2].copy()
        #        re_img = cv2.resize(im, (WIDTH, HEIGHT), interpolation=cv2.INTER_NEAREST)
        #        if True:
        #            if labels[idx] == 1:
        #                outpath = 'temp/fg/{}_clip{:03d}.jpg'.format(tempname, idx)
        #                print labels[idx], outpath
        #            else:

        #                outpath = 'temp/bg/{}_clip{:03d}.jpg'.format(tempname, idx)
        #            cv2.imwrite(outpath, re_img)
                #re_img *= 1./255
                #samples.append(re_img)

            #X_in = np.array(samples)
            #y_prob = bdt32.predict(X_in)
    #cnn_fg_inds = np.where(y_prob[:, 1]>0.8)[0]
        #    out_rois = rois[:, 1:5].copy()

        #    if flipped:
	    #        oldx1 = out_rois[:, 0].copy()
	    #        out_rois[:, 0] = w - out_rois[:, 2] - 1
	    #        out_rois[:, 2] = w - oldx1 - 1

        #    pnums = out_rois.shape[0]
        #    #filepath = 'temp/{}.txt'.format(imgname)
        #    #outfile = open(filepath, 'a')
        #    remove_keep = []
        #    for idx in range(pnums):
        #        coords = out_rois[idx]
        #        x1, y1, x2, y2 = coords.astype(int)
        #        if pp_check_coord([x1,y1,x2,y2], [w,h]): continue
        #        im = im_orig[y1:y2, x1:x2].copy()
        #        im *= 1./255
        #        re_img = cv2.resize(im, (WIDTH, HEIGHT))
        #        yp = self.bdt32.predict(re_img[np.newaxis,:])[0,1]
        #        scr = scores[idx]
        #        if yp <= 0.4 and scr <= 0.9:
        #        #if scr <= 0.9:
        #            remove_keep.append(idx)

        #    ada_keep = np.setdiff1d(np.arange(pnums), remove_keep)
        #    if ada_keep.size != 0:
        #        rois = rois[ada_keep, :]
        #        labels = labels[ada_keep]
        #    else:
        #        rois = rois[0, :]
        #        rois = rois[np.newaxis, :]
        #        labels = labels[0]
        #        print 'rois shape {} labels shape {}'.format(rois.shape, labels.shape)

	#print outimgdata.shape
        # sampled rois
        top[0].reshape(*rois.shape)
        top[0].data[...] = rois

        # classification labels
        top[1].reshape(*labels.shape)
        top[1].data[...] = labels

        # bbox_targets
        top[2].reshape(*bbox_targets.shape)
        top[2].data[...] = bbox_targets

        # bbox_inside_weights
        top[3].reshape(*bbox_inside_weights.shape)
        top[3].data[...] = bbox_inside_weights

        # bbox_outside_weights
        top[4].reshape(*bbox_inside_weights.shape)
        top[4].data[...] = np.array(bbox_inside_weights > 0).astype(np.float32)

    def backward(self, top, propagate_down, bottom):
        """This layer does not propagate gradients."""
        pass

    def reshape(self, bottom, top):
        """Reshaping happens during the call to forward."""
        pass


    def check_bbox_covered(self, boxes_a, boxes_b, thresh=0.01):
                                                                  
        overlaps = bbox_overlaps(
            np.ascontiguousarray(boxes_a[np.newaxis, :], dtype=np.float),
            np.ascontiguousarray(boxes_b, dtype=np.float))
        #print boxes_a[np.newaxis, :].shape, boxes_b.shape

        idxs = np.where(overlaps > thresh)[0]
        #bnum = boxes_b.shape[0]                                       
        #inters = np.zeros(bnum)                                       
        #for j in range(bnum):                                         
        #    ixmin = max(boxes_a[0], boxes_b[j, 0])                    
        #    iymin = max(boxes_a[1], boxes_b[j, 1])                    
        #    ixmax = min(boxes_a[2], boxes_b[j, 2])                    
        #    iymax = min(boxes_a[3], boxes_b[j, 3])                    
        #    iw = max(ixmax - ixmin + 1., 0.)                          
        #    ih = max(iymax - iymin + 1., 0.)                          
        #    inter = iw * ih                                           
        #                                                              
        #    inters[j] = inter                                         
        #zeros_num = np.count_nonzero(inters==0)                      
        #print 'inters ', inters                                      
        #print 'zero inter num: ', zeros_num                          
        return idxs.size

    def check_new_roi(self, bbox, filename):

        bbox_array = np.array(bbox)
        target_file = os.path.join('temp', filename+'.txt')
        if os.stat(target_file).st_size == 0: return False
        target_bbox_lines = open(target_file).readlines()
        target_bbox = []
        for i, line in enumerate(target_bbox_lines):
                elem = line.strip().split(' ')[:-1]
                if len(elem) == 4:
                    #print elem
                    target_bbox.append(np.array(elem, dtype=np.int))
        target_bbox_array = np.array(target_bbox)
        #target_bbox_array = np.array([np.array(line.strip().split(' ')[:-1], dtype=np.int) for line in target_bbox_lines])

        #print bbox_array.shape, target_bbox_array.shape
        #print target_bbox_array
       
        #return self.check_bbox_covered(bbox_array, target_bbox_array, thresh=0.3)
        return self.check_bbox_covered(bbox_array, target_bbox_array)



def _get_bbox_regression_labels(bbox_target_data, num_classes):
    """Bounding-box regression targets (bbox_target_data) are stored in a
    compact form N x (class, tx, ty, tw, th)

    This function expands those targets into the 4-of-4*K representation used
    by the network (i.e. only one class has non-zero targets).

    Returns:
        bbox_target (ndarray): N x 4K blob of regression targets
        bbox_inside_weights (ndarray): N x 4K blob of loss weights
    """

    clss = bbox_target_data[:, 0]
    bbox_targets = np.zeros((clss.size, 4 * num_classes), dtype=np.float32)
    bbox_inside_weights = np.zeros(bbox_targets.shape, dtype=np.float32)
    inds = np.where(clss > 0)[0]
    for ind in inds:
        cls = clss[ind]
        start = 4 * cls
        start = int(start)
        end = start + 4
        end = int(end)
        bbox_targets[ind, start:end] = bbox_target_data[ind, 1:]
        bbox_inside_weights[ind, start:end] = cfg.TRAIN.BBOX_INSIDE_WEIGHTS
    return bbox_targets, bbox_inside_weights


def _compute_targets(ex_rois, gt_rois, labels):
    """Compute bounding-box regression targets for an image."""

    assert ex_rois.shape[0] == gt_rois.shape[0]
    assert ex_rois.shape[1] == 4
    assert gt_rois.shape[1] == 4

    targets = bbox_transform(ex_rois, gt_rois)
    if cfg.TRAIN.BBOX_NORMALIZE_TARGETS_PRECOMPUTED:
        # Optionally normalize targets by a precomputed mean and stdev
        targets = ((targets - np.array(cfg.TRAIN.BBOX_NORMALIZE_MEANS))
                / np.array(cfg.TRAIN.BBOX_NORMALIZE_STDS))
    return np.hstack(
            (labels[:, np.newaxis], targets)).astype(np.float32, copy=False)

def _sample_rois(all_rois, gt_boxes, fg_rois_per_image, rois_per_image, num_classes, img):
    """Generate a random sample of RoIs comprising foreground and background
    examples.
    """
    #idx = 0
    #gts = gt_boxes / im_info
    #if flipped:
    #    oldx1 = gts[:, 0].copy()
    #    gts[:, 0] = im.shape[1] - gts[:, 2] - 1
    #    gts[:, 2] = im.shape[1] - oldx1 - 1
    #for rois, gt in zip(all_rois[:, 1:5], gts[:, :4]):
    #    rois = rois / im_info
    #    rx1, ry1, rx2, ry2 = rois.astype(int)
    #    gx1, gy1, gx2, gy2 = gt.astype(int)
    #    #print rx1, ry1, rx2, ry2
    #    #print gx1, gy1, gx2, gy2
    #    rois_im = im[ry1:ry2, rx1:rx2]
    #    gt_im = im[gy1:gy2, gx1:gx2]
    #            #l = labels[idx]
    #    rois_outpath = 'temp/sample/{}_rois_clip{:03d}.jpg'.format(imgname,idx)
    #    gt_outpath = 'temp/sample/{}_gt_clip{:03d}.jpg'.format(imgname,idx)
    #    cv2.imwrite(rois_outpath, rois_im)
    #    cv2.imwrite(gt_outpath, gt_im)
    #    idx += 1
    pnums = all_rois.shape[0]
    tempname = time.time()
    samples = []
    for idx in range(pnums):
        coords = all_rois[idx, 1:5]
        if pp_check_coord(coords, [1200, 600]):
            #print img.shape, coords
            re_img = np.zeros((HEIGHT, WIDTH, 3))
        else:
            x1, y1, x2, y2 = coords.astype(int)
            im = img[y1:y2, x1:x2].copy()
            re_img = cv2.resize(im, (WIDTH, HEIGHT), interpolation=cv2.INTER_NEAREST)
        if False:
            outpath = 'temp/ba/{}_clip{:03d}.jpg'.format(tempname, idx)
            cv2.imwrite(outpath, re_img)
        re_img *= 1./255
        samples.append(re_img)

    X_in = np.array(samples)
    y_prob = bdt32.predict(X_in)
    cnn_fg_inds = np.where(y_prob[:, 1]>0.8)[0]
        
    # overlaps: (rois x gt_boxes)
    overlaps = bbox_overlaps(
        np.ascontiguousarray(all_rois[:, 1:5], dtype=np.float),
        np.ascontiguousarray(gt_boxes[:, :4], dtype=np.float))
    #print overlaps.shape
    gt_assignment = overlaps.argmax(axis=1)
    #print gt_assignment
    max_overlaps = overlaps.max(axis=1)
    labels = gt_boxes[gt_assignment, 4]
    #print labels

    # Select foreground RoIs as those with >= FG_THRESH overlap
    fg_inds = np.where(max_overlaps >= cfg.TRAIN.FG_THRESH)[0]
    # Guard against the case when an image has fewer than fg_rois_per_image
    # foreground RoIs
    fg_rois_per_this_image = min(fg_rois_per_image, fg_inds.size)
    fg_rois_per_this_image = int(fg_rois_per_this_image)
    # Sample foreground regions without replacement
    if fg_inds.size > 0:
        fg_inds = npr.choice(fg_inds, size=fg_rois_per_this_image, replace=False)

    # Select background RoIs as those within [BG_THRESH_LO, BG_THRESH_HI)
    bg_inds = np.where((max_overlaps < cfg.TRAIN.BG_THRESH_HI) &
                       (max_overlaps >= cfg.TRAIN.BG_THRESH_LO))[0]
    # Compute number of background RoIs to take from this image (guarding
    # against there being fewer than desired)
    bg_rois_per_this_image = rois_per_image - fg_rois_per_this_image
    bg_rois_per_this_image = min(bg_rois_per_this_image, bg_inds.size)
    # Sample background regions without replacement
    if bg_inds.size > 0:
        bg_inds = npr.choice(bg_inds, size=bg_rois_per_this_image, replace=False)

    # The indices that we're selecting (both fg and bg)
    cnn_bg_inds = np.setdiff1d(bg_inds, cnn_fg_inds)
    keep_inds = np.append(fg_inds, cnn_bg_inds)
    #keep_inds = np.append(fg_inds, bg_inds)
    # Select sampled values from various arrays:
    labels = labels[keep_inds]
    #print labels.shape[0], labels
    # Clamp labels for the background RoIs to 0
    labels[fg_rois_per_this_image:] = 0
    #print labels
    rois = all_rois[keep_inds]
    #print rois.shape[0]

    ious = max_overlaps[keep_inds]

    bbox_target_data = _compute_targets(
        rois[:, 1:5], gt_boxes[gt_assignment[keep_inds], :4], labels)

    bbox_targets, bbox_inside_weights = \
        _get_bbox_regression_labels(bbox_target_data, num_classes)

    return labels, rois, bbox_targets, bbox_inside_weights
    
def pp_check_coord(bbox, size):
    
    x1 = bbox[0]
    y1 = bbox[1]
    x2 = bbox[2]
    y2 = bbox[3]

    Flag = False
    #print x1, y1, x2, y2
    # check x, y
    if x1 < 0 or x1 >= size[0]:
       Flag = True
    if y1 < 0 or y1 >= size[1]:
       Flag = True
    if x2 < 0 or x2 >= size[0]:
       Flag = True
    if y2 < 0 or y2 >= size[1]:
       Flag = True
    if x1 == x2 or y1 == y2:
       Flag = True

    return Flag
