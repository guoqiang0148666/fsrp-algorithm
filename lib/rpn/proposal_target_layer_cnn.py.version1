        all_rois = bottom[0].data
	#print 'all rois shape:', all_rois.shape
        # GT boxes (x1, y1, x2, y2, label)
        # TODO(rbg): it's annoying that sometimes I have extra info before
        # and other times after box coordinates -- normalize to one format
        gt_boxes = bottom[1].data
        im_info  = bottom[2].data
        img = np.squeeze(bottom[3].data)
        channel_swap = (1, 2, 0)  
        img = img.transpose(channel_swap)
        im_orig = img + cfg.PIXEL_MEANS 
        #setname = bottom[3].data[0,0]
        #vidname = bottom[3].data[0,1]
        #framename = bottom[3].data[0,2]
        #flipped = bottom[3].data[0,3]
        #data = bottom[4].data
        #imgname = 'set{:02d}_V{:03d}_I{:05d}'.format(int(setname), int(vidname), int(framename))
        #im_orig = cv2.imread('/home/guo/titan/datasets/caltech-gtx1080/VOC2007/JPEGImages/{}_usatrain.jpg'.format(imgname))
        #img = cv2.resize(im_orig, (800, 600))
	    #print imgname
	    #if flipped: print '%s' % (imgname)
        h, w, _ = im_orig.shape
        is_all_zero = np.all(gt_boxes == 0)

        if not is_all_zero:
            zeros = np.zeros((gt_boxes.shape[0], 1), dtype=gt_boxes.dtype)
            all_rois = np.vstack(
            (all_rois, np.hstack((zeros, gt_boxes[:, :-1])))
        )

        # Sanity check: single batch only
        assert np.all(all_rois[:, 0] == 0), \
                'Only single item batches are supported'

        num_images = 1
        rois_per_image = cfg.TRAIN.BATCH_SIZE / num_images
        fg_rois_per_image = np.round(cfg.TRAIN.FG_FRACTION * rois_per_image).astype(np.int)

        # Sample rois with classification labels and bounding box regression
        # targets
        if not is_all_zero:
            labels, rois, bbox_targets, bbox_inside_weights = _sample_rois(
                all_rois, gt_boxes, fg_rois_per_image, rois_per_image, self._num_classes, im_orig)
            #labels, rois, bbox_targets, bbox_inside_weights, ious = _sample_rois(
            #    all_rois, gt_boxes, fg_rois_per_image,
            #    rois_per_image, self._num_classes)
	    #print 'not all zero'
	    #print 'all shape:', labels.shape, rois.shape, bbox_targets.shape, bbox_inside_weights.shape
        else:
            labels = np.zeros_like(labels)
	        #labels = np.zeros((128, 1), dtype=np.float32) 
	        #rois = np.zeros((128, 5),  dtype=np.float32)
	        #bbox_targets = np.zeros((128, 8),  dtype=np.float32)
	        #bbox_inside_weights =  np.zeros((128, 8),  dtype=np.float32)
	        #print 'all zero'
	        #print 'all shape:', labels.shape, rois.shape, bbox_targets.shape, bbox_inside_weights.shape

        if DEBUG:
            print 'num fg: {}'.format((labels > 0).sum())
